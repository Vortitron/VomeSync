{
	"name": "vomesync-webserver",
	"version": "1.0.0",
	"description": "VomeSync WebServer - Public Remote Switch API and WebSocket Server",
	"main": "src/server.js",
	"scripts": {
		"start": "node src/server.js",
		"dev": "nodemon src/server.js",
		"test": "jest",
		"lint": "eslint src/",
		"docker:build": "docker build -t vomesync-webserver .",
		"docker:run": "docker run -p 3000:3000 -p 3001:3001 vomesync-webserver"
	},
	"keywords": [
		"home-assistant",
		"websocket",
		"iot",
		"remote-switch",
		"real-time"
	],
	"author": "Callycode Limited",
	"license": "Proprietary",
	"dependencies": {
		"express": "^4.18.2",
		"ws": "^8.14.2",
		"redis": "^4.6.10",
		"uuid": "^9.0.1",
		"jsonwebtoken": "^9.0.2",
		"helmet": "^7.1.0",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"joi": "^17.11.0",
		"winston": "^3.11.0",
		"rate-limiter-flexible": "^3.0.8"
	},
	"devDependencies": {
		"nodemon": "^3.0.1",
		"jest": "^29.7.0",
		"eslint": "^8.53.0",
		"supertest": "^6.3.3"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
