# VomeSync WebServer Configuration
PORT=3090
WS_PORT=3001
NODE_ENV=production

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
JWT_SECRET=your-jwt-secret-here-change-this-in-production
# Optional: dedicated secret for hashing bearer keys before storing in Redis.
# Defaults to JWT_SECRET if unset.
KEY_HASH_SECRET=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CAPTCHA (optional; enforced when HCAPTCHA_SECRET is set)
HCAPTCHA_SECRET=
HCAPTCHA_SITEKEY=
# For testing/staging you can set a bypass token; leave empty in production
HCAPTCHA_BYPASS_TOKEN=

# Server Configuration
CORS_ORIGINS=https://sync.vome.io,http://localhost:8123
SSL_CERT_PATH=
SSL_KEY_PATH=

# Privacy and Analytics
ENABLE_ANALYTICS=true
DIFFERENTIAL_PRIVACY_EPSILON=1.0

# Logging
LOG_LEVEL=info
LOG_FILE=logs/vomesync.log
