#!/command/with-contenv bashio
# Serve the tree-view control panel (ingress) and keep the add-on alive.
set -e

export VOME_PANEL_PORT="${VOME_PANEL_PORT:-8099}"
export VOME_PANEL_STATIC="/usr/share/vome/panel/static"

bashio::log.info "Starting Vome control panel on :${VOME_PANEL_PORT}"
exec python3 /usr/share/vome/panel/server.py
