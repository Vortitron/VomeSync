// =============================================================================
// VomeSync Supervisor add-ons — Release packaging + publishing
//
// Packages one add-on, tests it, and -- if GITHUB_TOKEN is available --
// publishes the result as a GitHub Release with the zip attached. Runs
// manually from the Jenkins GUI, or automatically from
// vome-addon-autorelease whenever an add-on's config.yaml version changes and
// has no matching release tag yet.
//
// Two add-ons (owner, 30 Sept 2026: make CHAP's releases match): Vome
// (vome/, tags vome-addon-vX.Y.Z) and Vome CHAP (vome_chap/, tags
// vome-chap-vX.Y.Z, release notes from its CHANGELOG.md). Which one comes
// from ADDON, or from the tag's prefix: a parameter new to a Jenkinsfile is
// only registered after the job's first run, and until then a caller's
// ADDON would be dropped without a word -- and Vome released instead.
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(
            name: 'ADDON',
            choices: ['vome', 'vome_chap'],
            description: 'Which add-on: vome (Vome) or vome_chap (Vome CHAP). A RELEASE_TAG starting vome-chap- means vome_chap whatever this says.'
        )
        string(
            name: 'RELEASE_TAG',
            defaultValue: '',
            description: 'Git tag for the published release (example: vome-addon-v0.3.37). Leave empty to use vX.Y.Z from config.yaml -- note this becomes the actual release tag now, not just an artefact label.'
        )
    }

    options {
        ansiColor('xterm')
        timestamps()
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '30'))
    }

    stages {
        stage('Which add-on') {
            steps {
                script {
                    def tag = (params.RELEASE_TAG ?: '').trim()
                    env.ADDON_DIR = tag.startsWith('vome-chap-') ? 'vome_chap' : (params.ADDON ?: 'vome')
                    currentBuild.description = "${env.ADDON_DIR} ${tag ?: '(tag from config.yaml)'}"
                }
            }
        }

        stage('Validate CHAP') {
            when { environment name: 'ADDON_DIR', value: 'vome_chap' }
            steps {
                sh '''
                    test -f repository.yaml
                    test -f vome_chap/config.yaml
                    test -f vome_chap/Dockerfile
                    test -f vome_chap/chap_sync.py
                    test -f vome_chap/local_pair.py
                    test -f vome_chap/CHANGELOG.md
                    test -f vome/package_release.py
                '''
            }
        }

        stage('Test CHAP') {
            when { environment name: 'ADDON_DIR', value: 'vome_chap' }
            steps {
                sh '''
                    python3.11 -m venv .venv-addon
                    . .venv-addon/bin/activate
                    python -m pip install --upgrade pip
                    pip install -r hacs-addon/tests/requirements.txt
                    python -m pytest \
                        hacs-addon/tests/test_chap_sync.py \
                        hacs-addon/tests/test_local_pair.py \
                        --tb=short -q \
                        --junitxml=junit-vome-addon-release.xml
                '''
            }
            post {
                always {
                    junit 'junit-vome-addon-release.xml'
                }
            }
        }

        stage('Validate') {
            when { environment name: 'ADDON_DIR', value: 'vome' }
            steps {
                sh '''
                    test -f repository.yaml
                    test -f vome/config.yaml
                    test -f vome/Dockerfile
                    test -f vome/build.sh
                    test -f vome/package_release.py
                    test -f vome/panel/server.py
                    test -f custom_components/vomesync/manifest.json
                    test -f custom_components/vomesync/services_remote.py
                '''
            }
        }

        stage('Sync + Test') {
            when { environment name: 'ADDON_DIR', value: 'vome' }
            steps {
                sh '''
                    chmod +x vome/build.sh
                    ./vome/build.sh
                    diff -qr custom_components/vomesync vome/custom_components/vomesync

                    python3.11 -m venv .venv-addon
                    . .venv-addon/bin/activate
                    python -m pip install --upgrade pip
                    pip install -r hacs-addon/tests/requirements.txt
                    python -m pytest \
                        hacs-addon/tests/test_lan_routes.py \
                        hacs-addon/tests/test_addon_packaging.py \
                        hacs-addon/tests/test_panel_ui.py \
                        --tb=short -q \
                        --junitxml=junit-vome-addon-release.xml
                '''
            }
            post {
                always {
                    junit 'junit-vome-addon-release.xml'
                }
            }
        }

        stage('Build Release Artifact') {
            steps {
                sh '''
                    test -f vome/package_release.py
                    ADDON="$ADDON_DIR" python3 vome/package_release.py
                    test -f dist/release.txt
                    ls -la dist/*.zip
                '''
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'dist/*.zip,dist/*.txt,dist/*.md', fingerprint: true
            echo "${env.ADDON_DIR} release artifact created and archived."
            script {
                // Archiving in Jenkins is not a release: nothing outside this
                // Jenkins instance could ever discover the artefact. This is
                // what actually publishes it, using the same GITHUB_TOKEN /
                // GITHUB_USERNAME already used for HTTPS checkout -- they
                // reach every build via the container's env_file, so no
                // withCredentials wrapper is needed. A missing token warns
                // and skips (this stage is additive; the archived artifact
                // is still there either way); an attempted call that fails
                // fails the build, because a silently-not-actually-published
                // release is worse than a red build telling you so.
                if (!env.GITHUB_TOKEN?.trim()) {
                    echo 'GITHUB_TOKEN is not set -- skipping the GitHub release. The artifact is archived in Jenkins only.'
                } else {
                    def info = readFile('dist/release.txt').trim()
                    def props = [:]
                    info.split('\n').each { line ->
                        def parts = line.split('=', 2)
                        if (parts.length == 2) { props[parts[0]] = parts[1] }
                    }
                    def tag = props['tag']
                    def artifactName = props['artifact']
                    if (!tag || !artifactName) {
                        error("dist/release.txt did not contain both tag= and artifact=: ${info}")
                    }
                    def notes = props['notes'] ? "dist/${props['notes']}" : ''
                    withEnv(["RELEASE_TAG_RESOLVED=${tag}", "RELEASE_ARTIFACT=${artifactName}", "RELEASE_NOTES_FILE=${notes}"]) {
                        sh 'scripts/publish_addon_release.sh'
                    }
                }
            }
        }
        failure {
            echo "${env.ADDON_DIR ?: 'Add-on'} release pipeline failed."
        }
        cleanup {
            cleanWs()
        }
    }
}
