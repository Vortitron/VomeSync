// =============================================================================
// VomeSync Supervisor add-on — Auto-Release on a version bump
//
// vome-addon-release already does the real work (validate, sync + test,
// build the zip, publish) but has never been triggered by anything -- its
// own description used to say so ("Not triggered on push"). This is what
// starts it: a push to main that bumps vome/config.yaml's version gets a
// matching GitHub Release, the same way the HACS integration's own version
// bump gets one via .github/workflows/release.yml, without a human needing
// to remember either step.
//
// The tag is prefixed (vome-addon-vX.Y.Z, not vX.Y.Z) because this repo's
// tag namespace is shared with the HACS integration's own release tags,
// and those need to stay a clean vX.Y.Z for HACS's version display and
// update-comparison logic to read correctly.
//
// Both add-ons (owner, 30 Sept 2026: make CHAP's releases match): Vome
// (vome/config.yaml -> vome-addon-vX.Y.Z) and Vome CHAP
// (vome_chap/config.yaml -> vome-chap-vX.Y.Z). Each bump gets its own
// release; a push bumping both gets two.
// =============================================================================

pipeline {
	agent any

	options {
		ansiColor('xterm')
		timestamps()
		timeout(time: 30, unit: 'MINUTES')
		buildDiscarder(logRotator(numToKeepStr: '15', daysToKeepStr: '30'))
		disableConcurrentBuilds()
	}

	triggers {
		// Declared here too, not just in casc.yaml: a Jenkinsfile's own
		// triggers{} block only registers after the pipeline has run once,
		// so a brand-new job never fires without this. Confirmed the hard
		// way on the VomeHome side (jenkins/PIPELINES.md there) -- a job
		// with triggers only in the Jenkinsfile sat at "not built" forever,
		// waiting for a trigger that only a build would have registered.
		//
		// No pollSCM: every VomeSync job deliberately does without it (see
		// PIPELINES.md's "GitHub webhooks" section) -- the git plugin
		// reported spurious changes on every poll for this repo and ran a
		// full build every few minutes regardless of whether anything had
		// actually changed.
		githubPush()
	}

	stages {
		stage('Check for version bumps') {
			steps {
				script {
					sh 'git fetch --tags -q'
					def addons = [[dir: 'vome', prefix: 'vome-addon'], [dir: 'vome_chap', prefix: 'vome-chap']]
					def due = []
					def seen = []
					for (a in addons) {
						def version = sh(
							script: "grep -m1 '^version:' ${a.dir}/config.yaml | sed -E 's/version: *\"([^\"]+)\"/\\1/'",
							returnStdout: true
						).trim()
						if (!version) {
							error("Could not read a version out of ${a.dir}/config.yaml")
						}
						def tag = "${a.prefix}-v${version}"
						def existing = sh(script: "git tag -l '${tag}'", returnStdout: true).trim()
						seen << (existing ? "${tag} (already released)" : "${tag} (new)")
						if (!existing) {
							due << "${a.dir}=${tag}"
						}
					}
					env.ADDONS_DUE = due.join(' ')
					currentBuild.description = seen.join(', ')
				}
			}
		}

		stage('Release') {
			when {
				expression { env.ADDONS_DUE?.trim() }
			}
			steps {
				script {
					for (item in env.ADDONS_DUE.trim().split(' ')) {
						def parts = item.split('=', 2)
						build job: 'VomeSync/vome-addon-release', wait: true, propagate: true,
							parameters: [string(name: 'ADDON', value: parts[0]), string(name: 'RELEASE_TAG', value: parts[1])]
					}
				}
			}
		}
	}

	post {
		success {
			script {
				if (env.ADDONS_DUE?.trim()) {
					echo "✓ Released ${env.ADDONS_DUE}."
				} else {
					echo "No version bump -- nothing to release (${currentBuild.description})."
				}
			}
		}
		failure {
			echo "✗ Add-on auto-release failed (${env.ADDONS_DUE ?: 'unresolved versions'}) -- check vome-addon-release for which stage gave up."
		}
	}
}
