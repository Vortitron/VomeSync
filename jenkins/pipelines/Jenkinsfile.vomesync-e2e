// =============================================================================
// VomeSync — End-to-End Test Pipeline
//
// Spins up the full Docker Compose stack (Redis + webserver), runs the Python
// E2E test suite against it, then tears everything down.
//
// Requires Docker socket access from the Jenkins container.
// =============================================================================

pipeline {
    agent any

    options {
        ansiColor('xterm')
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        booleanParam(
            name: 'FORCE_RUN',
            defaultValue: false,
            description: 'Run E2E tests even when no SCM changes are detected'
        )
    }

    environment {
        RUN_E2E = 'true'
        COMPOSE_PROJECT_NAME = "vomesync-e2e-${BUILD_NUMBER}"
        // Standalone stack (no container_name / fixed ports / shared volumes):
        // the production stack runs on the same Docker daemon, so the main
        // compose file would collide with it — and tests on the default
        // localhost:3090 would silently hit production.
        COMPOSE_FILE_E2E = 'docker-compose.e2e.yml'
    }

    stages {
        stage('Scope Check') {
            steps {
                script {
                    def forceRun = (params.FORCE_RUN ?: false)
                    def changedFiles = []
                    def firstBuild = (currentBuild.number == 1)

                    for (def changeSet in currentBuild.changeSets) {
                        for (def entry in changeSet.items) {
                            for (def file in entry.affectedFiles) {
                                changedFiles << file.path
                            }
                        }
                    }

                    if (forceRun || !changedFiles.isEmpty() || firstBuild) {
                        env.RUN_E2E = 'true'
                    } else {
                        env.RUN_E2E = 'false'
                        currentBuild.description = 'No SCM changes'
                    }
                }
            }
        }

        stage('Prepare Environment') {
            when {
                expression { env.RUN_E2E == 'true' }
            }
            steps {
                sh '''
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --upgrade pip
                    pip install -r tests/e2e/requirements.txt
                '''
            }
        }

        stage('Start Services') {
            when {
                expression { env.RUN_E2E == 'true' }
            }
            steps {
                dir('docker') {
                    sh 'docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE_E2E" up -d --build --wait vomesync-redis vomesync-webserver'
                }
                script {
                    // Ephemeral host ports — discover what Docker assigned.
                    def apiPort = sh(
                        script: 'cd docker && docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE_E2E" port vomesync-webserver 3090 | cut -d: -f2',
                        returnStdout: true
                    ).trim()
                    def wsPort = sh(
                        script: 'cd docker && docker compose -p "$COMPOSE_PROJECT_NAME" -f "$COMPOSE_FILE_E2E" port vomesync-webserver 3001 | cut -d: -f2',
                        returnStdout: true
                    ).trim()
                    if (!apiPort || !wsPort) {
                        error "Could not resolve e2e stack ports (api='${apiPort}', ws='${wsPort}')"
                    }
                    // Jenkins itself runs in a container on a bridge network, so
                    // host-published ports are NOT on its localhost — they are on
                    // the default-route gateway (the Docker host). Prefer localhost
                    // when it answers (bare-metal agents), else use the gateway.
                    def hostIp = sh(
                        script: '''
                            gw_hex=$(awk '$2 == "00000000" { print $3; exit }' /proc/net/route)
                            if [ -n "$gw_hex" ]; then
                                echo "$((0x$(echo $gw_hex | cut -c7-8))).$((0x$(echo $gw_hex | cut -c5-6))).$((0x$(echo $gw_hex | cut -c3-4))).$((0x$(echo $gw_hex | cut -c1-2)))"
                            fi
                        ''',
                        returnStdout: true
                    ).trim()
                    def apiHost = 'localhost'
                    def localhostOk = sh(
                        script: "curl -sf -m 5 http://localhost:${apiPort}/api/health >/dev/null",
                        returnStatus: true
                    ) == 0
                    if (!localhostOk && hostIp) {
                        apiHost = hostIp
                    }
                    env.E2E_API_URL = "http://${apiHost}:${apiPort}"
                    env.E2E_WS_URL = "ws://${apiHost}:${wsPort}"
                    echo "E2E stack: API ${env.E2E_API_URL}, WS ${env.E2E_WS_URL}"
                }
                sh '''
                    echo "Waiting for API at $E2E_API_URL..."
                    timeout 180 bash -c "until curl -sf ${E2E_API_URL}/api/health; do sleep 2; done"
                    echo "API is healthy."
                '''
            }
        }

        stage('Run E2E Tests') {
            when {
                expression { env.RUN_E2E == 'true' }
            }
            steps {
                sh '''
                    . .venv/bin/activate
                    python -m pytest tests/e2e/ \
                        -v --tb=short \
                        --junitxml=junit-e2e.xml
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'junit-e2e.xml'
                }
            }
        }

        stage('Skipped') {
            when {
                expression { env.RUN_E2E != 'true' }
            }
            steps {
                echo 'No changes detected. E2E tests skipped.'
            }
        }
    }

    post {
        always {
            script {
                if (env.RUN_E2E == 'true') {
                    sh """
                        echo "── Service logs ──"
                        cd docker
                        docker compose -p "${env.COMPOSE_PROJECT_NAME}" -f "${env.COMPOSE_FILE_E2E}" logs --tail=80 || true
                        echo "── Tearing down ──"
                        docker compose -p "${env.COMPOSE_PROJECT_NAME}" -f "${env.COMPOSE_FILE_E2E}" down -v --remove-orphans || true
                    """
                }
            }
        }
        success {
            echo '✓ VomeSync E2E tests passed.'
        }
        failure {
            echo '✗ VomeSync E2E tests failed.'
        }
        cleanup {
            cleanWs()
        }
    }
}
