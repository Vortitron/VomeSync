# VomeSync Docker Environment Configuration

# Security (REQUIRED in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Optional: dedicated secret for hashing bearer keys before storing in Redis.
# Defaults to JWT_SECRET if unset.
KEY_HASH_SECRET=
REDIS_PASSWORD=your-redis-password-change-this

# Persistent volume names (optional, but recommended to keep data stable across upgrades)
# If you change these after you have users, you will effectively "switch databases".
VOMESYNC_REDIS_VOLUME_NAME=vomesync_redis_data
VOMESYNC_LOGS_VOLUME_NAME=vomesync_webserver_logs
VOMESYNC_MEDIA_VOLUME_NAME=vomesync_webserver_media

# LIVE vs DEV (important):
# - LIVE (production) is the stack behind `sync.vome.io` and uses the non-DEV variables below.
# - DEV (development) is for local testing and uses the *_DEV_* variables.
# - `docker/scripts/deploy.sh status` prints the current LIVE/DEV ports in use.

# Host Ports (optional; defaults shown). If a default is in use, `docker/scripts/deploy.sh`
# will automatically pick the next free port for that run.
VOMESYNC_API_HOST_PORT=3090
VOMESYNC_WS_HOST_PORT=3001
VOMESYNC_WEBSITE_HOST_PORT=8111
VOMESYNC_PROXY_HTTP_HOST_PORT=8080
VOMESYNC_PROXY_HTTPS_HOST_PORT=8443

# Development Host Ports (optional)
VOMESYNC_API_DEV_HOST_PORT=3091
VOMESYNC_WS_DEV_HOST_PORT=3002
VOMESYNC_WEBSITE_DEV_HOST_PORT=8112
VOMESYNC_REDIS_DEV_HOST_PORT=6381

# Domain Configuration
API_DOMAIN=sync.vome.io
WEBSITE_DOMAIN=sync.vome.io

# SSL Configuration (optional, set paths to enable HTTPS)
ENABLE_SSL=false
SSL_CERT_PATH=/path/to/your/certificate.pem
SSL_KEY_PATH=/path/to/your/private.key

# CORS Origins (comma-separated)
CORS_ORIGINS=https://sync.vome.io,http://localhost:8123

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Analytics and Privacy
ENABLE_ANALYTICS=true
DIFFERENTIAL_PRIVACY_EPSILON=1.0

# Logging
LOG_LEVEL=info

# Development Overrides (for local development)
# Uncomment these for local testing
# API_DOMAIN=localhost:3000
# WEBSITE_DOMAIN=localhost:8080
# CORS_ORIGINS=http://localhost:8080,http://localhost:8123
# ENABLE_SSL=false
